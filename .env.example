# Copy this file to .env and fill in your own keys
# Never commit the actual .env file to GitHub

# NewsAPI - get your key at newsapi.org
NEWSAPI_KEY=your_newsapi_key_here

# SEC EDGAR - just your email address, no sign up needed
SEC_USER_AGENT="ESG-Greenwashing-Scorer (contact: yourprojectemail@gmail.com)"

# Hugging Face Access token. To get a new one, to to huggingface.co
HF_TOKEN=your=token-here