# Copy this file to .env and fill in your own keys
# Never commit the actual .env file to GitHub

# NewsAPI - get your key at newsapi.org
NEWSAPI_KEY=your_newsapi_key_here

# SEC EDGAR - just your email address, no sign up needed
SEC_USER_AGENT=your_email_here

SEC_USER_AGENT="ESG-Scraper (contact: yourprojectemail@gmail.com)"